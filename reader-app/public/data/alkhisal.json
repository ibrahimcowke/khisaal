  "chapters": [
    {
      "id": "chapter-001",
      "title": "المقدمة ومدخل الموسوعة",
      "order": 1,
      "sourcePageStart": 1,
      "sourcePageEnd": 2,
      "pageIds": ["p001", "p002"],
      "wordCount": 380,
      "tags": ["المقدمة", "الأخلاق", "المروءة", "الحكمة"],
      "blocks": [
        {
          "id": "c1-b01",
          "type": "heading",
          "sourcePage": 1,
          "pageId": "p001",
          "text": "الخصال المائتان في السلوك والآداب والمروءة"
        },
        {
          "id": "c1-b02",
          "type": "callout",
          "sourcePage": 1,
          "pageId": "p001",
          "text": "موسوعة الخصال والحكم والآداب العربية · جامع المنظومات الأخلاقية والتربوية (200 خصلة مع الشروح والبيان) · عُنِي بجمعه وتنسيقه: إبراهيم عوكي"
        },
        {
          "id": "c1-b03",
          "type": "paragraph",
          "sourcePage": 1,
          "pageId": "p001",
          "text": "بسم الله الرحمن الرحيم، الحمد لله الذي زين الإنسان بمحاسن الآداب، وشرفه بمكارم الأخلاق، والصلاة والسلام على نبي الرحمة والمروءة، الهادي إلى أقوم سبيل، وعلى آله وصحبه أجمعين."
        },
        {
          "id": "c1-b04",
          "type": "quote",
          "sourcePage": 1,
          "pageId": "p001",
          "text": "«إِنَّ مِنْ خِيَارِكُمْ أَحْسَنَكُمْ أَخْلَاقًا»",
          "attribution": "صحيح البخاري"
        },
        {
          "id": "c1-b05",
          "type": "paragraph",
          "sourcePage": 2,
          "pageId": "p002",
          "text": "أما بعد؛ فهذا جامع نفيس ومنظومة سلوكية بديعة تضم مائتي خصلة (200 خصلة) من أصول الأخلاق والتربية والمروءة والآداب الاجتماعية، نظمت في خمسة أبواب جامعة: من الثنائيات إلى السداسيات، مشفوعة ببيان عللها وشروحها لتهذيب النفس ورعاية السمت الحسن."
        }
      ]
    },
    {
      "id": "chapter-002",
      "title": "أولاً: منظومة الثنائيات (20 خصلة)",
      "order": 2,
      "sourcePageStart": 3,
      "sourcePageEnd": 10,
      "pageIds": ["p003", "p004", "p005", "p006", "p007", "p008", "p009", "p010"],
      "wordCount": 940,
      "tags": ["منظومة الثنائيات", "السلوك", "الآداب", "المروءة"],
      "blocks": [
        {
          "id": "c2-b01",
          "type": "heading",
          "sourcePage": 3,
          "pageId": "p003",
          "text": "أولاً: منظومة الثنائيات (20 خصلة تربوية وأخلاقية)"
        },
        {
          "id": "c2-b02",
          "type": "paragraph",
          "sourcePage": 3,
          "pageId": "p003",
          "text": "1. الحرص الذي لا ينقضي:"
        },
        {
          "id": "c2-b03",
          "type": "callout",
          "sourcePage": 3,
          "pageId": "p003",
          "text": "طبيعة الرغبة الإنسانية إذا تعلقت بالعلم أو المادة تظل في حالة تطلع مستمر فطالب المعرفة يرى في كل مسألة باباً لغيرها فلا يقف عند حد، وطالب الدنيا يظل أسيراً لجمع الحطام والمتاع الزائل دون أن يشعر بالاكتفاء أو القناعة."
        },
        {
          "id": "c2-b04",
          "type": "list",
          "sourcePage": 3,
          "pageId": "p003",
          "items": [
            "طالب علم لا يرتوي من المعرفة",
            "طالب دنيا لا يشبع من الجمع"
          ]
        },
        {
          "id": "c2-b05",
          "type": "divider",
          "sourcePage": 4,
          "pageId": "p004"
        },
        {
          "id": "c2-b06",
          "type": "paragraph",
          "sourcePage": 4,
          "pageId": "p004",
          "text": "2. صفات التنافي الإيماني:"
        },
        {
          "id": "c2-b07",
          "type": "callout",
          "sourcePage": 4,
          "pageId": "p004",
          "text": "الإيمان الحقيقي يقوم على السماحة وبذل الخير للناس، ولذا لا تجتمع خصلة الشح المانعة للحقوق مع فظاظة الأخلاق وقسوتها في قلب مؤمن استقر فيه نور البصيرة ومكارم الشريعة."
        },
        {
          "id": "c2-b08",
          "type": "list",
          "sourcePage": 4,
          "pageId": "p004",
          "items": [
            "البخل المانع للواجب",
            "سوء الخلق المنفر للقلوب"
          ]
        },
        {
          "id": "c2-b09",
          "type": "divider",
          "sourcePage": 5,
          "pageId": "p005"
        },
        {
          "id": "c2-b10",
          "type": "paragraph",
          "sourcePage": 5,
          "pageId": "p005",
          "text": "3. موانع تحصيل المعرفة:"
        },
        {
          "id": "c2-b11",
          "type": "callout",
          "sourcePage": 5,
          "pageId": "p005",
          "text": "طريق العلم يتطلب الشجاعة في طرح الأسئلة والتواضع التام عند الجلوس بين يدي المعلمين فمن غلبه الخجل المفرط كتم جهله وضاع عليه الفهم، ومن استحوذ عليه الكبر ظن بنفسه الاستغناء فحرم من نيل الفائدة."
        },
        {
          "id": "c2-b12",
          "type": "list",
          "sourcePage": 5,
          "pageId": "p005",
          "items": [
            "الحياء المفرط المانع من السؤال",
            "الكبر الحائل دون الاستفادة"
          ]
        },
        {
          "id": "c2-b13",
          "type": "divider",
          "sourcePage": 6,
          "pageId": "p006"
        },
        {
          "id": "c2-b14",
          "type": "paragraph",
          "sourcePage": 6,
          "pageId": "p006",
          "text": "4. قوادح المروءة والسمت:"
        },
        {
          "id": "c2-b15",
          "type": "callout",
          "sourcePage": 6,
          "pageId": "p006",
          "text": "تتلاشى هيبة الإنسان ومروءته بين أقرانه إذا اعتاد الخوض في الجدال العقيم لإثبات الغلبة فقط، أو اعتاد نقض عهوده وإخلاف مواعيده، مما يفقده ثقة الناس واحترامهم."
        },
        {
          "id": "c2-b16",
          "type": "list",
          "sourcePage": 6,
          "pageId": "p006",
          "items": [
            "كثرة الجدال والمراء",
            "إخلاف الوعود والعهود"
          ]
        },
        {
          "id": "c2-b17",
          "type": "divider",
          "sourcePage": 7,
          "pageId": "p007"
        },
        {
          "id": "c2-b18",
          "type": "paragraph",
          "sourcePage": 7,
          "pageId": "p007",
          "text": "5. جالبات الهم الدائم:"
        },
        {
          "id": "c2-b19",
          "type": "callout",
          "sourcePage": 7,
          "pageId": "p007",
          "text": "النظر الدائم إلى نعم الآخرين يولد في النفس حسرة واضطراباً لا ينتهيان فالحسد ينهك الجسد والروح والطمع فيما في أيدي الناس يجعل القلب فقيراً مهما اتسعت موارده وأمواله."
        },
        {
          "id": "c2-b20",
          "type": "list",
          "sourcePage": 7,
          "pageId": "p007",
          "items": [
            "حسد الأقران على النعم",
            "الطمع فيما في أيدي الناس"
          ]
        },
        {
          "id": "c2-b21",
          "type": "divider",
          "sourcePage": 8,
          "pageId": "p008"
        },
        {
          "id": "c2-b22",
          "type": "paragraph",
          "sourcePage": 8,
          "pageId": "p008",
          "text": "6. أسباب توطيد الود:"
        },
        {
          "id": "c2-b23",
          "type": "callout",
          "sourcePage": 8,
          "pageId": "p008",
          "text": "بقاء العلاقات الإنسانية واستمرار الألفة مرهون بالتغاضي الحكيم عن الهفوات والزلات غير المقصودة والوقوف الصادق بجانب الإخوان وتقديم يد العون والمواساة لهم عند نزول الشدائد والمحن."
        },
        {
          "id": "c2-b24",
          "type": "list",
          "sourcePage": 8,
          "pageId": "p008",
          "items": [
            "التغافل عن الهفوات الصغيرة",
            "بذل العون عند الشدائد"
          ]
        },
        {
          "id": "c2-b25",
          "type": "divider",
          "sourcePage": 9,
          "pageId": "p009"
        },
        {
          "id": "c2-b26",
          "type": "paragraph",
          "sourcePage": 9,
          "pageId": "p009",
          "text": "7. مهلكات التفكير السليم:"
        },
        {
          "id": "c2-b27",
          "type": "callout",
          "sourcePage": 9,
          "pageId": "p009",
          "text": "يتعطل العقل عن اتخاذ القرارات الصائبة حين يُسلم صاحبه زمام نفسه للرغبات اللحظية والأهواء المجردة أو حين ينفرد برأيه مستغنياً عن خبرات وتجارب المشيرين وأهل الحكمة."
        },
        {
          "id": "c2-b28",
          "type": "list",
          "sourcePage": 9,
          "pageId": "p009",
          "items": [
            "اتباع الهوى بغير هدى",
            "الاستبداد بالرأي وترك المشورة"
          ]
        },
        {
          "id": "c2-b29",
          "type": "divider",
          "sourcePage": 10,
          "pageId": "p010"
        },
        {
          "id": "c2-b30",
          "type": "paragraph",
          "sourcePage": 10,
          "pageId": "p010",
          "text": "8. نعم الغفلة والخسران:"
        },
        {
          "id": "c2-b31",
          "type": "callout",
          "sourcePage": 10,
          "pageId": "p010",
          "text": "أثمن ما يملكه الإنسان في رحلته هما عافية بدنه وسعة وقته، غير أن الغالبية العظمى تفرط فيهما في التوافه، ولا تدرك قيمتهما الحقيقية إلا بعد نزول المرض وزحمة المشاغل."
        },
        {
          "id": "c2-b32",
          "type": "list",
          "sourcePage": 10,
          "pageId": "p010",
          "items": [
            "صحة البدن قبل السقم",
            "فراغ الوقت قبل الانشغال"
          ]
        },
        {
          "id": "c2-b33",
          "type": "paragraph",
          "sourcePage": 10,
          "pageId": "p010",
          "text": "9. موجبات الرفعة والمنزلة:"
        },
        {
          "id": "c2-b34",
          "type": "callout",
          "sourcePage": 10,
          "pageId": "p010",
          "text": "السيادة الحقيقية والشرف لا ينالان بالاستعلاء والتفاخر، وإنما بكسر النفس للتواضع حين تعلو المراتب والمناصب، وبالرجوع إلى الحق والاعتراف بالخطأ والإنصاف من النفس دون مكابرة."
        },
        {
          "id": "c2-b35",
          "type": "list",
          "sourcePage": 10,
          "pageId": "p010",
          "items": [
            "التواضع عند علو المنزلة",
            "الإنصاف وقبول الحق على النفس"
          ]
        },
        {
          "id": "c2-b36",
          "type": "paragraph",
          "sourcePage": 10,
          "pageId": "p010",
          "text": "10. أمور لا دوام لها:"
        },
        {
          "id": "c2-b37",
          "type": "callout",
          "sourcePage": 10,
          "pageId": "p010",
          "text": "الكيانات المبنية على أسس هشة مصيرها إلى الفناء السريع فالمال الحرام تنزع منه البركة ويؤول إلى الهلاك، والصداقة القائمة على تبادل المصالح العابرة تنتهي بمجرد انقضاء المنفعة."
        },
        {
          "id": "c2-b38",
          "type": "list",
          "sourcePage": 10,
          "pageId": "p010",
          "items": [
            "كسب الحرام السريع الزوال",
            "صحبة النفع المؤقتة"
          ]
        }
      ]
    },
    {
      "id": "chapter-003",
      "title": "ثانياً: منظومة الثلاثيات (45 خصلة)",
      "order": 3,
      "sourcePageStart": 11,
      "sourcePageEnd": 22,
      "pageIds": ["p011", "p012", "p013", "p014", "p015", "p016", "p017", "p018", "p019", "p020", "p021", "p022"],
      "wordCount": 1380,
      "tags": ["منظومة الثلاثيات", "المنجيات والمهلكات", "مكارم الأخلاق"],
      "blocks": [
        {
          "id": "c3-b01",
          "type": "heading",
          "sourcePage": 11,
          "pageId": "p011",
          "text": "ثانياً: منظومة الثلاثيات (45 خصلة)"
        },
        {
          "id": "c3-b02",
          "type": "paragraph",
          "sourcePage": 11,
          "pageId": "p011",
          "text": "1. أصول المهلكات النفسية:"
        },
        {
          "id": "c3-b03",
          "type": "callout",
          "sourcePage": 11,
          "pageId": "p011",
          "text": "ثلاثة آفات تقضي على جوهر الإيمان وتهوي بصاحبها في مهاوي الردى الأخلاقي فالبخل يدفع إلى قطيعة الواجب، والهوى يقود لارتكاب المعاصي، والغرور يعمي البصيرة عن رؤية العيوب الشخصية."
        },
        {
          "id": "c3-b04",
          "type": "list",
          "sourcePage": 11,
          "pageId": "p011",
          "items": [
            "شح مطاع يمنع الحقوق",
            "هوى متبع يقود إلى المعاصي",
            "عجب يطمس البصيرة"
          ]
        },
        {
          "id": "c3-b05",
          "type": "divider",
          "sourcePage": 12,
          "pageId": "p012"
        },
        {
          "id": "c3-b06",
          "type": "paragraph",
          "sourcePage": 12,
          "pageId": "p012",
          "text": "2. أصول المنجيات:"
        },
        {
          "id": "c3-b07",
          "type": "callout",
          "sourcePage": 12,
          "pageId": "p012",
          "text": "قواعد النجاة التي تحفظ توازن الإنسان واستقامته في شتى الأحوال وتقلبات الزمان فتجعله خائفاً من ربه في خلوته وجلوته، مقتصداً في نفقاته، وعادلاً في أحكامه حتى مع ألد خصومه."
        },
        {
          "id": "c3-b08",
          "type": "list",
          "sourcePage": 12,
          "pageId": "p012",
          "items": [
            "مراقبة الخالق سراً وعلانية",
            "القصد والاعتدال في الفقر والغنى",
            "العدل مع الصديق والعدو"
          ]
        },
        {
          "id": "c3-b09",
          "type": "divider",
          "sourcePage": 13,
          "pageId": "p013"
        },
        {
          "id": "c3-b10",
          "type": "paragraph",
          "sourcePage": 13,
          "pageId": "p013",
          "text": "3. مكفرات الخطايا والآثام:"
        },
        {
          "id": "c3-b11",
          "type": "callout",
          "sourcePage": 13,
          "pageId": "p013",
          "text": "أفعال بدنية وقولية يسيرة المأخذ عظيمة الأثر، تسهم في تكفير الذنوب ونشر المحبة بين أفراد المجتمع عبر السلام، وسد جوعة المحتاجين، والاتصال بالخالق حين يغفل الناس في هجعة الليل."
        },
        {
          "id": "c3-b12",
          "type": "list",
          "sourcePage": 13,
          "pageId": "p013",
          "items": [
            "إفشاء السلام بين الناس",
            "إطعام الطعام وسد الحاجة",
            "قيام الليل والناس نيام"
          ]
        },
        {
          "id": "c3-b13",
          "type": "divider",
          "sourcePage": 14,
          "pageId": "p014"
        },
        {
          "id": "c3-b14",
          "type": "paragraph",
          "sourcePage": 14,
          "pageId": "p014",
          "text": "4. درجات القرب والرفعة:"
        },
        {
          "id": "c3-b15",
          "type": "callout",
          "sourcePage": 14,
          "pageId": "p014",
          "text": "أعمال العبادة التي تتطلب صبراً وتغلباً على مشاق النفس وكسلها، فترفع صاحبها إلى أعلى المراتب الروحية بفضل إحسان الطهارة، والمداومة على شهود الجماعة، وتعلق القلب بالمساجد."
        },
        {
          "id": "c3-b16",
          "type": "list",
          "sourcePage": 14,
          "pageId": "p014",
          "items": [
            "إسباغ الوضوء على المكاره",
            "كثرة الخطى إلى المساجد",
            "انتظار الصلاة بعد الصلاة"
          ]
        },
        {
          "id": "c3-b17",
          "type": "divider",
          "sourcePage": 15,
          "pageId": "p015"
        },
        {
          "id": "c3-b18",
          "type": "paragraph",
          "sourcePage": 15,
          "pageId": "p015",
          "text": "5. علامات ضعف الديانة:"
        },
        {
          "id": "c3-b19",
          "type": "callout",
          "sourcePage": 15,
          "pageId": "p015",
          "text": "أمارات سلوكية تنذر بفساد السريرة وتغلغل النفاق في القلب وتتجلى في تعمد تزييف الحقائق باللسان، والجرأة على نقض الوعود، وخيانة الأمانات المادية والمعنوية حين يؤتمن عليها."
        },
        {
          "id": "c3-b20",
          "type": "list",
          "sourcePage": 15,
          "pageId": "p015",
          "items": [
            "كذب الحديث عند الإخبار",
            "إخلاف الوعد عند الالتزام",
            "خيانة الأمانة عند المؤتمن"
          ]
        },
        {
          "id": "c3-b21",
          "type": "divider",
          "sourcePage": 16,
          "pageId": "p016"
        },
        {
          "id": "c3-b22",
          "type": "paragraph",
          "sourcePage": 16,
          "pageId": "p016",
          "text": "6. ركائز مسلك العاقل:"
        },
        {
          "id": "c3-b23",
          "type": "callout",
          "sourcePage": 16,
          "pageId": "p016",
          "text": "المنهج الحياتي الراشد الذي يوازن بين متطلبات الدنيا وواجبات الآخرة فيسعى المرء لتنمية ماله بالوجوه المشروعة، والتزود بالعمل الصالح ليوم الحساب، والترويح عن النفس بالمباح دون شطط."
        },
        {
          "id": "c3-b24",
          "type": "list",
          "sourcePage": 16,
          "pageId": "p016",
          "items": [
            "السعي في استصلاح المال",
            "الاستعداد والتزود للمعاد",
            "التمتع بالمباح دون إسراف"
          ]
        },
        {
          "id": "c3-b25",
          "type": "divider",
          "sourcePage": 17,
          "pageId": "p017"
        },
        {
          "id": "c3-b26",
          "type": "paragraph",
          "sourcePage": 17,
          "pageId": "p017",
          "text": "7. أمور لا يستحيا منها:"
        },
        {
          "id": "c3-b27",
          "type": "callout",
          "sourcePage": 17,
          "pageId": "p017",
          "text": "أفعال أصيلة قد يتوهم البعض أنها تنقص من الهيبة، بينما هي في حقيقتها شواهد على كرم الطبع وعلو الهمة والحرص على صيانة الحقوق وأداء الواجبات الأسرية والاجتماعية."
        },
        {
          "id": "c3-b28",
          "type": "list",
          "sourcePage": 17,
          "pageId": "p017",
          "items": [
            "خدمة الضيف وإكرامه",
            "القيام للوالد والمعلم توقيراً",
            "طلب الحق المالي وإن قل"
          ]
        },
        {
          "id": "c3-b29",
          "type": "divider",
          "sourcePage": 18,
          "pageId": "p018"
        },
        {
          "id": "c3-b30",
          "type": "paragraph",
          "sourcePage": 18,
          "pageId": "p018",
          "text": "8. موجبات الألفة والمحبة:"
        },
        {
          "id": "c3-b31",
          "type": "callout",
          "sourcePage": 18,
          "pageId": "p018",
          "text": "مفاتيح يسيرة تأسر القلوب وتزيل النفور بين الناس في المجالس إذ تبعث البشاشة في النفس الراحة، وتفتح المبادرة بالتحية أبواب الحوار، ويدل إفساح المكان على التقدير والاحترام."
        },
        {
          "id": "c3-b32",
          "type": "list",
          "sourcePage": 18,
          "pageId": "p018",
          "items": [
            "طلاقة الوجه والبشاشة",
            "المبادرة بالسلام والتحية",
            "إفساح المجلس للقادم"
          ]
        },
        {
          "id": "c3-b33",
          "type": "paragraph",
          "sourcePage": 19,
          "pageId": "p019",
          "text": "9. قواطع حبال الأخوة: التمادي في اللجاجة والخصومة، إفشاء السر المؤتمن عليه، وكثرة اللوم والتعنيف."
        },
        {
          "id": "c3-b34",
          "type": "paragraph",
          "sourcePage": 20,
          "pageId": "p020",
          "text": "10. حقوق الجليس الصالح: الترحيب به عند إقباله، التوسيع له في مكان الجلوس، والإنصات لحديثه دون قطع."
        },
        {
          "id": "c3-b35",
          "type": "paragraph",
          "sourcePage": 21,
          "pageId": "p021",
          "text": "11. مذهبات الهم والحزن: المداومة على ذكر الله، لقاء الإخوان الصالحين ومحادثتهم، والتأمل في الطبيعة والماء والخضرة."
        },
        {
          "id": "c3-b36",
          "type": "paragraph",
          "sourcePage": 21,
          "pageId": "p021",
          "text": "12. ضرورات استقامة الحياة: عقل راجح يدبر الأمور، دين صادق يمنع الزلل، وستر وحسن حال يغني عن السؤال."
        },
        {
          "id": "c3-b37",
          "type": "paragraph",
          "sourcePage": 22,
          "pageId": "p022",
          "text": "13. مسقطات الهيبة والمكانة: الإفراط في المزاح الرديء، كثرة الضحك المستخف، ونقل الشائعات وفضول الكلام."
        },
        {
          "id": "c3-b38",
          "type": "paragraph",
          "sourcePage": 22,
          "pageId": "p022",
          "text": "14. أصناف يتعذر إصلاحهم: عدو يحركه الحسد المحض، أحمق يصر على جهله ولجاجه، وطماع لا يقنع بعطاء."
        },
        {
          "id": "c3-b39",
          "type": "paragraph",
          "sourcePage": 22,
          "pageId": "p022",
          "text": "15. أسس حسن السمت: الصمت إلا عن خير، كف اللسان عن أعراض الناس، ومقابلة الإساءة بالحلم والإحسان."
        }
      ]
    },
    {
      "id": "chapter-004",
      "title": "ثالثاً: منظومة الرباعيات (48 خصلة)",
      "order": 4,
      "sourcePageStart": 23,
      "sourcePageEnd": 34,
      "pageIds": ["p023", "p024", "p025", "p026", "p027", "p028", "p029", "p030", "p031", "p032", "p033", "p034"],
      "wordCount": 1410,
      "tags": ["منظومة الرباعيات", "الآداب الاجتماعية", "الحكمة والمروءة"],
      "blocks": [
        {
          "id": "c4-b01",
          "type": "heading",
          "sourcePage": 23,
          "pageId": "p023",
          "text": "ثالثاً: منظومة الرباعيات (48 خصلة)"
        },
        {
          "id": "c4-b02",
          "type": "paragraph",
          "sourcePage": 23,
          "pageId": "p023",
          "text": "1. أركان السعادة الدنيوية:"
        },
        {
          "id": "c4-b03",
          "type": "callout",
          "sourcePage": 23,
          "pageId": "p023",
          "text": "نعم دنيوية جامعة تجعل حياة المرء طيبة هنيئة فتكتمل سكينة القلب بامرأة تعينه على شؤونه، ودار واسعة تستوعب أهله وضيوفه، وجار يأمن بوائقه، ومركب مريح يبلغه مقصده بيسر."
        },
        {
          "id": "c4-b04",
          "type": "list",
          "sourcePage": 23,
          "pageId": "p023",
          "items": [
            "زوجة صالحة تعين على الخير",
            "مسكن فسيح تطمئن به النفس",
            "جار طيب مأمون الجانب",
            "مركب مريح يقضي الحاجة"
          ]
        },
        {
          "id": "c4-b05",
          "type": "divider",
          "sourcePage": 24,
          "pageId": "p024"
        },
        {
          "id": "c4-b06",
          "type": "paragraph",
          "sourcePage": 24,
          "pageId": "p024",
          "text": "2. أسباب الشقاء والنكد:"
        },
        {
          "id": "c4-b07",
          "type": "callout",
          "sourcePage": 24,
          "pageId": "p024",
          "text": "منغصات مستمرة تسلب المرء هدوءه النفسي وتجعل حياته اليومية سلسلة من التوتر كرفيق درب سيئ الطباع، وجار مؤذ يتربص العثرات، ومسكن ضيق يكتم الأنفاس، ودابة أو وسيلة رديئة تعطل الأعمال."
        },
        {
          "id": "c4-b08",
          "type": "list",
          "sourcePage": 24,
          "pageId": "p024",
          "items": [
            "زوجة سوء تكدر العيش",
            "جار سوء يؤذي ولا يأمن",
            "بيت ضيق يورث الضنك",
            "مركب سيئ يعطل المصالح"
          ]
        },
        {
          "id": "c4-b09",
          "type": "divider",
          "sourcePage": 25,
          "pageId": "p025"
        },
        {
          "id": "c4-b10",
          "type": "paragraph",
          "sourcePage": 25,
          "pageId": "p025",
          "text": "3. أعمدة السيادة والمروءة:"
        },
        {
          "id": "c4-b11",
          "type": "callout",
          "sourcePage": 25,
          "pageId": "p025",
          "text": "خصال أربع متكاملة ترفع شأن صاحبها وتجعله سيداً في قومه فالأدب يزين قوله وفعله، والعلم ينير قراراته والأمانة تجلب ثقة الناس، والعفة تصون مكانته عن الرذائل وشبهات المطامع."
        },
        {
          "id": "c4-b12",
          "type": "list",
          "sourcePage": 25,
          "pageId": "p025",
          "items": [
            "أدب رفيع يجمل القول والعمل",
            "علم نافع ينير الطريق",
            "أمانة تحفظ العهود والحقوق",
            "عفة تصون العرض والجوارح"
          ]
        },
        {
          "id": "c4-b13",
          "type": "divider",
          "sourcePage": 26,
          "pageId": "p026"
        },
        {
          "id": "c4-b14",
          "type": "paragraph",
          "sourcePage": 26,
          "pageId": "p026",
          "text": "4. مظلمات القلب والروح: امتلاء البطن على الدوام من غير جوع، مرافقة الظلمة ومجالستهم، نسيان الذنوب السالفة دون توبة، وطول الأمل والتسويف."
        },
        {
          "id": "c4-b15",
          "type": "paragraph",
          "sourcePage": 27,
          "pageId": "p027",
          "text": "5. منيرات البصيرة والقلب: اعتدال البطن وقلة الشبع، صحبة الصالحين وأهل الفضل، استحضار الزلات بالندم والاستغفار، وقصر الأمل وذكر الموت."
        },
        {
          "id": "c4-b16",
          "type": "paragraph",
          "sourcePage": 28,
          "pageId": "p028",
          "text": "6. مهلكات الجسد والنشاط: المبالغة في حمل الهموم، الاستسلام للغم والحزن، الجوع المفرط المنهك للبدن، والسهر الطويل بغير مصلحة."
        },
        {
          "id": "c4-b17",
          "type": "paragraph",
          "sourcePage": 29,
          "pageId": "p029",
          "text": "7. قواعد ضبط المنطق: الكف عما يورث اللوم والندم، ترك تعييب الآخرين بالعيوب، عدم تغليب الهزل على الجد، والإعراض عما لا نفع فيه."
        },
        {
          "id": "c4-b18",
          "type": "paragraph",
          "sourcePage": 30,
          "pageId": "p030",
          "text": "8. شواهد كرم النبعة: الصبر الجميل عند نزول البلاء، التغاضي والتغافل عن عثرات الأصدقاء، نجدة المحتاج بلا من ولا أذى، وكتمان الأسرار وصيانتها."
        },
        {
          "id": "c4-b19",
          "type": "paragraph",
          "sourcePage": 31,
          "pageId": "p031",
          "text": "9. موجبات زوال النعم: جحود الإحسان ونكران الجميل، الامتناع عن أداء الحقوق والزكاة، التكبر والبطر عند الثراء، والظلم والاعتداء على الضعفاء."
        },
        {
          "id": "c4-b20",
          "type": "paragraph",
          "sourcePage": 32,
          "pageId": "p032",
          "text": "10. أشياء لا تشبع أبداً: أرض عطشى من غيث، عين ناظرة من مشهد حسن، طالب علم من المعرفة والفهم، ونفس حريصة من جمع المال."
        },
        {
          "id": "c4-b21",
          "type": "paragraph",
          "sourcePage": 33,
          "pageId": "p033",
          "text": "11. أصول المعاشرة الاجتماعية: المبادرة ببذل المعروف، حبس الأذى واللسان عن الخلق، احتمال جفاء الطباع بالصبر، والمداراة باللطف وحسن الخلق."
        },
        {
          "id": "c4-b22",
          "type": "paragraph",
          "sourcePage": 34,
          "pageId": "p034",
          "text": "12. دلائل الجهل ورعونة الفكر: سرعة الغضب لأتفه الأسباب، الخوض في الكلام بغير فائدة، صرف المال في غير مواضعه، ووضع الثقة في غير موضعها."
        }
      ]
    },
    {
      "id": "chapter-005",
      "title": "رابعاً: منظومة الخماسيات (45 خصلة)",
      "order": 5,
      "sourcePageStart": 35,
      "sourcePageEnd": 43,
      "pageIds": ["p035", "p036", "p037", "p038", "p039", "p040", "p041", "p042", "p043"],
      "wordCount": 1280,
      "tags": ["منظومة الخماسيات", "الحكمة", "الأخلاق", "النماء والبركة"],
      "blocks": [
        {
          "id": "c5-b01",
          "type": "heading",
          "sourcePage": 35,
          "pageId": "p035",
          "text": "رابعاً: منظومة الخماسيات (45 خصلة)"
        },
        {
          "id": "c5-b02",
          "type": "paragraph",
          "sourcePage": 35,
          "pageId": "p035",
          "text": "1. فرص العمر والشباب (اغتنم خمساً قبل خمس):"
        },
        {
          "id": "c5-b03",
          "type": "callout",
          "sourcePage": 35,
          "pageId": "p035",
          "text": "خمس محطات حاسمة في حياة الإنسان يجب المبادرة إلى استثمارها قبل فوات أوانها؛ فالقوة يعقبها الضعف، والعافية يهددها السقم، والسعة قد يخلفها الضيق والفراغ يزول بالأعباء، والفرصة تنعدم بالموت."
        },
        {
          "id": "c5-b04",
          "type": "list",
          "sourcePage": 35,
          "pageId": "p035",
          "items": [
            "زمن الشباب قبل حلول المشيب",
            "وقت الصحة قبل نزول الأسقام",
            "سعة الغنى قبل عوارض الفقر",
            "أوقات الفراغ قبل مزاحمة المشاغل",
            "أيام الحياة قبل فوات الأجل"
          ]
        },
        {
          "id": "c5-b05",
          "type": "divider",
          "sourcePage": 36,
          "pageId": "p036"
        },
        {
          "id": "c5-b06",
          "type": "paragraph",
          "sourcePage": 36,
          "pageId": "p036",
          "text": "2. قواصم المروءة والشرف: الوقوع في الغيبة وإشاعة النميمة، نقض العهود بعد توثيقها، الشماتة في مصائب الآخرين، نكران معروف من أحسن، والتفاخر الكاذب والطعن في الأنساب."
        },
        {
          "id": "c5-b07",
          "type": "paragraph",
          "sourcePage": 37,
          "pageId": "p037",
          "text": "3. قواعد العقل والحكمة: لزوم الصمت حتى تدعو الحاجة، الإصغاء التام لمن يتكلم، تدبر مآلات الأمور قبل الشروع، الصدق المطلق في إنجاز الوعد، والصفح عند توفر أسباب الانتقام."
        },
        {
          "id": "c5-b08",
          "type": "paragraph",
          "sourcePage": 38,
          "pageId": "p038",
          "text": "4. أسباب الفاقة وضيق المعيشة: الإفراط في النوم وإضاعة الصباح، قلة الحمد عند نيل القليل، تبديد المال في الشهوات التافهة، أكل أموال الناس بالباطل والمماطلة، والغش في التعامل والكيل والميزان."
        },
        {
          "id": "c5-b09",
          "type": "paragraph",
          "sourcePage": 39,
          "pageId": "p039",
          "text": "5. جالبات البركة والنماء: صلة الأرحام وتفقد الأقارب، الصدق والوضوح في التجارة، التبكير إلى السعي في طلب الرزق، كثرة الاستغفار والمداومة عليه، والإنفاق على الفقراء والمحتاجين."
        },
        {
          "id": "c5-b10",
          "type": "paragraph",
          "sourcePage": 40,
          "pageId": "p040",
          "text": "6. شروط الصداقة الراسخة: التوافق على الحق ونصرته، حفظ الغيبة والذب عن العرض، بذل النصيحة بلا فضيحة، إقالة العثرات وستر الزلات، والثبات على المودة في الشدة والرخاء."
        },
        {
          "id": "c5-b11",
          "type": "paragraph",
          "sourcePage": 41,
          "pageId": "p041",
          "text": "7. موجبات الندم والحسرة: التسرع في الحكم دون استبانة، الاستجابة للغضب الأعمى، البخل بالحقوق الواجبة، الترفع والاستكبار على الناس، ومنع الجاه والشفاعة في المعروف."
        },
        {
          "id": "c5-b12",
          "type": "paragraph",
          "sourcePage": 42,
          "pageId": "p042",
          "text": "8. آداب تحصيل العلوم: احترام المعلم وتقدير مقامه، المداومة على المراجعة والتثبت، التواضع مع الزملاء والقرناء، تطبيق العلم وتحويله إلى عمل، وتحمل مشاق السهر والبحث."
        },
        {
          "id": "c5-b13",
          "type": "paragraph",
          "sourcePage": 43,
          "pageId": "p043",
          "text": "9. علامات طهارة الباطن: عدم التأثر المفرط بالمدح أو الذم، الرقة والرحمة بالضعفاء والمساكين، خلو القلب من الحقد والحسد، جود النفس وبذل ما تيسر، وتمني الخير والهداية للجميع."
        }
      ]
    },
    {
      "id": "chapter-006",
      "title": "خامساً: منظومة السداسيات (42 خصلة)",
      "order": 6,
      "sourcePageStart": 44,
      "sourcePageEnd": 50,
      "pageIds": ["p044", "p045", "p046", "p047", "p048", "p049", "p050"],
      "wordCount": 1050,
      "tags": ["منظومة السداسيات", "المروءة", "آداب المجالس", "مكارم السلوك"],
      "blocks": [
        {
          "id": "c6-b01",
          "type": "heading",
          "sourcePage": 44,
          "pageId": "p044",
          "text": "خامساً: منظومة السداسيات (42 خصلة جامعة)"
        },
        {
          "id": "c6-b02",
          "type": "paragraph",
          "sourcePage": 44,
          "pageId": "p044",
          "text": "1. شروط التمكن من المعرفة (وصية الإمام الشافعي):"
        },
        {
          "id": "c6-b03",
          "type": "callout",
          "sourcePage": 44,
          "pageId": "p044",
          "text": "الوصية الجامعة المأثورة عن الإمام الشافعي لتحصيل رسوخ القدم في العلوم وتتطلب توقد الذهن، وشدة الحرص، وبذل الجهد المتواصل، ووجود كفاية من الرزق تحفظ الوقت والتلقي المباشر عن أستاذ ناصح وطول ملازمة المدارسة عبر السنين."
        },
        {
          "id": "c6-b04",
          "type": "list",
          "sourcePage": 44,
          "pageId": "p044",
          "items": [
            "ذكاء وفطنة لاستيعاب الدقائق",
            "حرص وتوق للمعرفة لا يهدأ",
            "اجتهاد ومثابرة بغير انقطاع",
            "كفاية من الرزق تحفظ الكرامة",
            "ملازمة المعلم الناصح والتلقي عنه",
            "امتداد الزمان وطول الممارسة"
          ]
        },
        {
          "id": "c6-b05",
          "type": "divider",
          "sourcePage": 45,
          "pageId": "p045"
        },
        {
          "id": "c6-b06",
          "type": "paragraph",
          "sourcePage": 45,
          "pageId": "p045",
          "text": "2. الواجبات الاجتماعية المتبادلة: إلقاء السلام ورده عند اللقاء، إجابة الدعوة وإكرام الداعي، تقديم النصح المخلص عند طلبه، تشميت العاطس إذا حمد الله، عيادة المريض وتخفيف كربه، وتشييع الجنائز والدعاء للميت."
        },
        {
          "id": "c6-b07",
          "type": "paragraph",
          "sourcePage": 46,
          "pageId": "p046",
          "text": "3. مسقطات الوقار والمروءة: فضول الكلام والثرثرة الفارغة، الضحك بصوت عال بغير حياء، الاستهزاء بخلق الله والتنمر، الشكوى المستمرة وإظهار الفاقة للناس، مخالطة أهل الفسق والجهل، وتضييع الواجبات لاتباع الهوى."
        },
        {
          "id": "c6-b08",
          "type": "paragraph",
          "sourcePage": 47,
          "pageId": "p047",
          "text": "4. شواهد كمال الرأي والحلم: كظم الغيظ عند الغضب الشديد، كتمان السر حتى عن أقرب الناس، استشارة أصحاب العقول والتجارب، الحذر من مواطن الشبهات والريب، التزام العدل حتى مع الخصوم، والاشتغال بالعيوب الشخصية وترك الفضول."
        },
        {
          "id": "c6-b09",
          "type": "paragraph",
          "sourcePage": 48,
          "pageId": "p048",
          "text": "5. مفسدات الأعمال والأجور: تتبع عورات الناس والتشهير بهم، قسوة القلب والجمود عند التذكير، التكالب على الدنيا ونسيان الآخرة، التبجح بالمعصية وقلة الحياء، تأخير التوبة والاتكال على الأماني، واستمراء الظلم والاعتداء على الحقوق."
        },
        {
          "id": "c6-b10",
          "type": "paragraph",
          "sourcePage": 49,
          "pageId": "p049",
          "text": "6. آداب المجالس الرفيعة: غض البصر عن محارم الجالسين، خفض الصوت والحديث بوقار، رد السلام بطلاقة وإكرام من حضر، التوجه بالوجه للمتحدث وإشعاره بالاهتمام، ترك مقاطعة المتكلم حتى ينتهي، والمحافظة على سرية ما يدور في المجلس."
        },
        {
          "id": "c6-b11",
          "type": "paragraph",
          "sourcePage": 50,
          "pageId": "p050",
          "text": "7. أعظم مكارم السلوك الإنساني: وصل القريب وإن مارس القطيعة، العطاء لمن منعك وحرمك، مسامحة من أوقع عليك الظلم، الحلم والصبر على من جهل وتطاول، تحري الصدق في الرضا والسخط، وأداء الأمانة كاملة لمن ائتمنك."
        }
      ]
    }
  ]
}